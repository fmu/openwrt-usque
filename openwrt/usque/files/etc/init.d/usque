#!/bin/sh /etc/rc.common
# usque procd init script
#
# UCI configuration: /etc/config/usque, section type "usque" named "main"
# (i.e. usque.main.*), see /etc/config/usque for the available options.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/usque
HOOK=/usr/libexec/usque/hook
FIREWALL=/usr/libexec/usque/firewall
STATE_DIR=/var/run/usque

log() { logger -t usque "$*"; }

load_config() {
	config_load usque
	config_get_bool enabled main enabled 0
	config_get config_file main config_file /etc/usque/warp0.json
	config_get interface main interface warp0
	config_get mtu main mtu 1400
	config_get_bool ipv6 main ipv6 0
	config_get_bool http2 main http2 0
	config_get endpoint_port main endpoint_port 443
	config_get_bool always_reconnect main always_reconnect 1
	config_get_bool auto_register main auto_register 1
	config_get device_name main device_name ''
	config_get log_level main log_level info
}

valid_iface() {
	case "$1" in
		''|*[!A-Za-z0-9_.-]*) return 1 ;;
	esac
	[ ${#1} -le 15 ]
}

# Register a new WARP device if the config file is missing.
ensure_config() {
	[ -s "$config_file" ] && return 0
	if [ "$auto_register" != 1 ]; then
		log "config file '$config_file' missing and auto_register=0; not starting"
		return 1
	fi
	log "config file '$config_file' missing, registering a new WARP device"
	mkdir -p "$(dirname "$config_file")" || return 1
	set -- --config "$config_file" register --accept-tos --force
	[ -n "$device_name" ] && set -- "$@" -n "$device_name"
	if command -v timeout >/dev/null 2>&1; then
		timeout 90 "$PROG" "$@"
		rc=$?
	else
		"$PROG" "$@"
		rc=$?
	fi
	if [ "$rc" -ne 0 ] || [ ! -s "$config_file" ]; then
		log "WARP registration failed (rc=$rc); not starting"
		return 1
	fi
	chmod 600 "$config_file"
	log "WARP registration succeeded"
	return 0
}

start_service() {
	load_config

	if [ "$enabled" != 1 ]; then
		log "service disabled (usque.main.enabled=0)"
		return 0
	fi
	valid_iface "$interface" || { log "invalid interface name '$interface'"; return 1; }
	case "$mtu" in ''|*[!0-9]*) log "invalid mtu '$mtu'"; return 1 ;; esac
	case "$endpoint_port" in ''|*[!0-9]*) log "invalid endpoint_port '$endpoint_port'"; return 1 ;; esac
	[ -x "$PROG" ] || { log "missing $PROG"; return 1; }

	mkdir -p "$STATE_DIR"
	ensure_config || return 0

	# Create/refresh the dedicated firewall zone before the tunnel comes up.
	if [ -x "$FIREWALL" ]; then
		"$FIREWALL" setup "$interface" >/dev/null 2>&1 || log "firewall zone setup failed"
	fi

	procd_open_instance usque
	procd_set_param command "$PROG" --config "$config_file" native-tun \
		-n "$interface" -m "$mtu" -P "$endpoint_port" \
		--on-connect "$HOOK" --on-disconnect "$HOOK"
	[ "$ipv6" = 1 ] && procd_append_param command --ipv6
	[ "$http2" = 1 ] && procd_append_param command --http2
	[ "$always_reconnect" = 1 ] && procd_append_param command --always-reconnect
	procd_set_param env \
		PATH=/usr/sbin:/usr/bin:/sbin:/bin \
		RUST_LOG="$log_level" \
		USQUE_IPV6_ENABLED="$ipv6" \
		USQUE_STATE_DIR="$STATE_DIR"
	# Do not hammer Cloudflare: at most 5 restarts, 10s apart, within 1h.
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	log "started: iface=$interface mtu=$mtu ipv6=$ipv6 http2=$http2 endpoint_port=$endpoint_port"
}

stop_service() {
	load_config
	mkdir -p "$STATE_DIR"

	# procd has already terminated the daemon, so its disconnect hook may not
	# have run: clean up routes explicitly (idempotent, restores WAN default).
	if [ -x "$HOOK" ]; then
		USQUE_EVENT=disconnect \
		USQUE_IFACE="$interface" \
		USQUE_ENDPOINT='' \
		USQUE_IPV6_ENABLED="$ipv6" \
		USQUE_STATE_DIR="$STATE_DIR" \
		"$HOOK" >/dev/null 2>&1 || true
	fi

	# Fallback in case the hook was missing or failed.
	ip -4 route del default dev "$interface" metric 0 >/dev/null 2>&1 || true
	ip -6 route del default dev "$interface" metric 0 >/dev/null 2>&1 || true

	log "stopped"
}

reload_service() {
	stop
	start
}
