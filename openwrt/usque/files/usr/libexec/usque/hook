#!/bin/sh
# usque routing hook (v2: multiple connections, opt-in routing)
#
# Invoked by the usque daemon on connect/disconnect with:
#   USQUE_EVENT         connect | disconnect
#   USQUE_IFACE         tunnel interface name
#   USQUE_IPV4/_IPV6    tunnel addresses
#   USQUE_ENDPOINT      WARP endpoint as ip:port or [ipv6]:port
# and by the init script with the per-section routing options:
#   USQUE_SECTION       UCI section name (instance / state owner)
#   USQUE_STATE_ROOT    shared state directory (/var/run/usque)
#   USQUE_STATE_DIR     per-section state directory
#   USQUE_DEFAULT_ROUTE 1 = install an IPv4 default route via the tunnel
#   USQUE_IPV6_ROUTE    auto | always | off  (install an IPv6 default route)
#   USQUE_IPV6_ENABLED  1 = the daemon runs with IPv6 enabled
#   USQUE_METRIC        route metric
#
# IMPORTANT: by default (default_route=0 and ipv6_route=auto with an existing
# native IPv6 default) this script makes NO routing changes at all.
#
# When routing is requested it:
#   - installs an endpoint bypass route via the current WAN for the address
#     family whose default route is being changed,
#   - installs "default dev <iface> metric <metric>" for that family,
#   - installs "ip rule priority 1000 from all lookup main" (per family) so
#     policy routing (mwan3) cannot divert traffic away from the main table.
# Ownership is ref-counted across sections; WAN defaults are saved once and
# restored when the last owning section disconnects.  The WAN default route is
# never removed while the tunnel is up (failover stays automatic).

STATE_ROOT="${USQUE_STATE_ROOT:-/var/run/usque}"
SECTION="${USQUE_SECTION:-default}"
STATE_DIR="${USQUE_STATE_DIR:-$STATE_ROOT/$SECTION}"
SHARED="$STATE_ROOT/shared"
LOG_TAG=usque
RETRIES=5
POLICY_PRIO=1000

log() { logger -t "$LOG_TAG" "$SECTION: hook: $*"; }

mkdir -p "$STATE_DIR" "$SHARED" 2>/dev/null

IFACE="${USQUE_IFACE:-}"
EVENT="${USQUE_EVENT:-}"
ENDPOINT="${USQUE_ENDPOINT:-}"
IPV6_ENABLED="${USQUE_IPV6_ENABLED:-0}"
IPV6_ROUTE="${USQUE_IPV6_ROUTE:-auto}"
DEFAULT_ROUTE="${USQUE_DEFAULT_ROUTE:-0}"
METRIC="${USQUE_METRIC:-0}"
case "$METRIC" in ''|*[!0-9]*) METRIC=0 ;; esac

[ -n "$IFACE" ] || { log "USQUE_IFACE not set, nothing to do"; exit 0; }
case "$IFACE" in
	*[!A-Za-z0-9_.-]*) log "invalid interface name '$IFACE', refusing"; exit 0 ;;
esac

# --- basic helpers ---------------------------------------------------------

# Run an ip command for an address family.  IPv4 uses the plain commands (no
# -4 flag) for maximum busybox compatibility.
ip_cmd() {
	local fam="$1"; shift
	if [ "$fam" = 6 ]; then
		ip -6 "$@"
	else
		ip "$@"
	fi
}

# Serialize shared state updates across instances.
lock() {
	local i=0
	while ! mkdir "$SHARED/.lock" 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -gt 20 ]; then
			rm -rf "$SHARED/.lock"
			i=0
		fi
		sleep 1
	done
}
unlock() { rmdir "$SHARED/.lock" 2>/dev/null; }

# Owner files contain "<section> <iface>" lines.
owner_add() {
	local file="$SHARED/$1"
	grep -q "^$SECTION " "$file" 2>/dev/null || printf '%s %s\n' "$SECTION" "$IFACE" >> "$file"
}
owner_del() {
	local file="$SHARED/$1"
	[ -f "$file" ] || return 0
	grep -v "^$SECTION " "$file" > "$file.tmp" 2>/dev/null || : > "$file.tmp"
	mv "$file.tmp" "$file"
}
owner_has() { grep -q "^$SECTION " "$SHARED/$1" 2>/dev/null; }
owner_count() {
	local n
	n="$(grep -c . "$SHARED/$1" 2>/dev/null || true)"
	printf '%s' "${n:-0}"
}
# Print the interfaces of all owners of an owner file (one per line).
owner_ifaces() {
	[ -f "$SHARED/$1" ] || return 0
	awk '{print $2}' "$SHARED/$1" | sort -u
}

# Print default routes without volatile tokens that "ip route replace" would
# not accept (e.g. "expires 1799sec", "linkdown").
sanitize_routes() {
	while IFS= read -r line; do
		line="$(printf '%s\n' "$line" | sed -e 's/ expires [0-9]*sec//g' \
			-e 's/ linkdown//g' -e 's/ dead//g' -e 's/ offload//g' \
			-e 's/ trap//g' -e 's/ notify//g')"
		[ -n "$line" ] && printf '%s\n' "$line"
	done
}

# --- endpoint bypass -------------------------------------------------------

# Split "1.2.3.4:443", "[2606:...]:443" or bare IPv6 into EP_IP / EP_FAM.
endpoint_split() {
	EP_IP=''
	EP_FAM=4
	case "$1" in
		\[*\]:*) EP_IP="${1%]:*}"; EP_IP="${EP_IP#[}"; EP_FAM=6 ;;
		\[*\])   EP_IP="${1%]}";  EP_IP="${EP_IP#[}"; EP_FAM=6 ;;
		*:*:*:*) EP_IP="$1"; EP_FAM=6 ;;
		*:*)     EP_IP="${1%:*}"; EP_FAM=4 ;;
		*)       EP_IP="$1" ;;
	esac
}

# Find the current route to the endpoint; sets RG_VIA and RG_DEV.
route_get() {
	local fam="$1" ipaddr="$2" out
	RG_VIA=''
	RG_DEV=''
	out="$(ip_cmd "$fam" route get "$ipaddr" 2>/dev/null)" || return 1
	[ -n "$out" ] || return 1
	# shellcheck disable=SC2086
	set -- $out
	while [ $# -gt 0 ]; do
		case "$1" in
			via) RG_VIA="$2"; shift 2 ;;
			dev) RG_DEV="$2"; shift 2 ;;
			*) shift ;;
		esac
	done
	[ -n "$RG_DEV" ] || return 1
	return 0
}

# Install an endpoint bypass route for family $1 (only if the endpoint is of
# that family).  Returns 0 if no bypass is needed/applicable.
add_endpoint_bypass() {
	local fam="$1" pfx=32 cur i=0
	[ -n "$ENDPOINT" ] || { log "no endpoint in environment, cannot add bypass"; return 1; }
	endpoint_split "$ENDPOINT"
	[ "$EP_FAM" = "$fam" ] || return 0
	[ -n "$EP_IP" ] || return 1
	while [ "$i" -lt "$RETRIES" ]; do
		route_get "$fam" "$EP_IP" && break
		i=$((i + 1))
		sleep 1
	done
	[ -n "$RG_DEV" ] || { log "could not resolve route to endpoint $EP_IP"; return 1; }
	if [ "$RG_DEV" = "$IFACE" ]; then
		log "endpoint $EP_IP already routed via $IFACE, no bypass needed"
		return 0
	fi
	[ "$fam" = 6 ] && pfx=128
	cur="$(ip_cmd "$fam" route show "$EP_IP/$pfx" 2>/dev/null)"
	if [ -n "$cur" ]; then
		log "endpoint route $EP_IP/$pfx already present"
	else
		if [ -n "$RG_VIA" ]; then
			ip_cmd "$fam" route replace "$EP_IP/$pfx" via "$RG_VIA" dev "$RG_DEV" 2>/dev/null \
				|| { log "failed to add bypass $EP_IP/$pfx via $RG_VIA dev $RG_DEV"; return 1; }
		else
			ip_cmd "$fam" route replace "$EP_IP/$pfx" dev "$RG_DEV" 2>/dev/null \
				|| { log "failed to add bypass $EP_IP/$pfx dev $RG_DEV"; return 1; }
		fi
		log "endpoint bypass: $EP_IP/$pfx via ${RG_VIA:-onlink} dev $RG_DEV"
	fi
	printf '%s %s %s\n' "$fam" "$EP_IP" "$RG_DEV" >> "$STATE_DIR/endpoints"
	return 0
}

del_endpoint_bypass() {
	local fam ipaddr dev pfx
	[ -f "$STATE_DIR/endpoints" ] || return 0
	while read -r fam ipaddr dev; do
		[ -n "$fam" ] && [ -n "$ipaddr" ] && [ -n "$dev" ] || continue
		pfx=32
		[ "$fam" = 6 ] && pfx=128
		ip_cmd "$fam" route del "$ipaddr/$pfx" dev "$dev" 2>/dev/null \
			|| ip_cmd "$fam" route del "$ipaddr/$pfx" 2>/dev/null \
			|| true
		log "removed endpoint bypass $ipaddr/$pfx dev $dev"
	done < "$STATE_DIR/endpoints"
	rm -f "$STATE_DIR/endpoints"
}

# --- shared default route / policy rule bookkeeping ------------------------

save_wan_defaults() {
	local fam="$1" file="$SHARED/wan-default-v$1"
	[ -e "$file" ] && return 0
	ip_cmd "$fam" route show default 2>/dev/null | sanitize_routes > "$file"
	[ -s "$file" ] || rm -f "$file"
}

restore_wan_defaults() {
	local fam="$1" file="$SHARED/wan-default-v$1" line remaining iface
	[ -s "$file" ] || { rm -f "$file"; return 0; }
	remaining="$(ip_cmd "$fam" route show default 2>/dev/null)"
	for iface in $(owner_ifaces "v$fam-default") "$IFACE"; do
		remaining="$(printf '%s\n' "$remaining" | grep -v "dev $iface" )"
	done
	if [ -n "$remaining" ]; then
		log "IPv$fam default route present after cleanup, nothing to restore"
		rm -f "$file"
		return 0
	fi
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		# shellcheck disable=SC2086
		if ip_cmd "$fam" route replace $line 2>/dev/null; then
			log "restored WAN default route: $line"
		else
			log "failed to restore WAN default route: $line"
		fi
	done < "$file"
	rm -f "$file"
}

policy_add() {
	local fam="$1" file="iprule-v$1"
	lock
	if [ "$(owner_count "$file")" -eq 0 ]; then
		if ip_cmd "$fam" rule add priority "$POLICY_PRIO" from all lookup main 2>/dev/null; then
			echo 1 > "$SHARED/$file.added"
			log "installed IPv$fam policy rule: priority $POLICY_PRIO from all lookup main"
		elif ip_cmd "$fam" rule show 2>/dev/null | grep -q "^$POLICY_PRIO:.*lookup main"; then
			echo 0 > "$SHARED/$file.added"
			log "IPv$fam policy rule priority $POLICY_PRIO already present"
		else
			unlock
			log "could not install IPv$fam policy rule priority $POLICY_PRIO"
			return 1
		fi
	fi
	owner_add "$file"
	unlock
	return 0
}

policy_del() {
	local fam="$1" file="iprule-v$1" added
	lock
	owner_del "$file"
	if [ "$(owner_count "$file")" -eq 0 ]; then
		added="$(cat "$SHARED/$file.added" 2>/dev/null)"
		if [ "$added" = 1 ]; then
			if ip_cmd "$fam" rule del priority "$POLICY_PRIO" 2>/dev/null; then
				log "removed IPv$fam policy rule priority $POLICY_PRIO"
			else
				log "IPv$fam policy rule priority $POLICY_PRIO already gone"
			fi
		fi
		rm -f "$SHARED/$file.added"
	fi
	unlock
}

# --- IPv4 default route (opt-in) -------------------------------------------

add_v4_default() {
	[ "$DEFAULT_ROUTE" = 1 ] || return 0
	add_endpoint_bypass 4 || log "IPv4 endpoint bypass failed; not changing the default route"
	[ -n "$RG_DEV" ] || return 0

	lock
	if [ "$(owner_count v4-default)" -eq 0 ]; then
		save_wan_defaults 4
	fi
	owner_add v4-default
	unlock

	if ip route replace default dev "$IFACE" metric "$METRIC" 2>/dev/null; then
		log "installed IPv4 default route dev $IFACE metric $METRIC"
	else
		log "failed to install IPv4 default route dev $IFACE"
	fi
	policy_add 4
}

del_v4_default() {
	[ "$DEFAULT_ROUTE" = 1 ] || return 0
	owner_has v4-default || return 0
	ip route del default dev "$IFACE" metric "$METRIC" 2>/dev/null \
		&& log "removed IPv4 default route dev $IFACE metric $METRIC"
	lock
	owner_del v4-default
	local last
	last="$(owner_count v4-default)"
	unlock
	if [ "$last" -eq 0 ]; then
		policy_del 4
		restore_wan_defaults 4
	fi
}

# --- IPv6 default route (auto/always/off, independent of default_route) -----

# Print an existing IPv6 default route that is not owned by us (if any).
# Routes via interfaces owned by another usque section are not "foreign".
v6_foreign_default() {
	local line dev iface skip
	ip -6 route show default 2>/dev/null | while IFS= read -r line; do
		[ -n "$line" ] || continue
		dev="$(printf '%s\n' "$line" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
		skip=0
		for iface in $(owner_ifaces v6-default); do
			[ "$iface" = "$dev" ] && skip=1
		done
		[ "$skip" = 0 ] && { printf '%s\n' "$line"; break; }
	done
}

add_v6_default() {
	[ "$IPV6_ENABLED" = 1 ] || return 0
	[ "$IPV6_ROUTE" = off ] && return 0
	if [ "$IPV6_ROUTE" = auto ] && [ -n "$(v6_foreign_default)" ]; then
		log "native IPv6 default route present, ipv6_route=auto: leaving IPv6 routing untouched"
		return 0
	fi
	if ! ip -6 addr show dev "$IFACE" scope global 2>/dev/null | grep -q 'inet6'; then
		log "no global IPv6 address on $IFACE, not installing an IPv6 default route"
		return 0
	fi
	add_endpoint_bypass 6 || log "IPv6 endpoint bypass failed; not changing the IPv6 default route"
	if [ -n "$ENDPOINT" ]; then
		endpoint_split "$ENDPOINT"
		[ "$EP_FAM" = 6 ] && [ -z "$RG_DEV" ] && return 0
	fi

	lock
	if [ "$(owner_count v6-default)" -eq 0 ]; then
		save_wan_defaults 6
	fi
	owner_add v6-default
	unlock

	if ip -6 route replace default dev "$IFACE" metric "$METRIC" 2>/dev/null; then
		log "installed IPv6 default route dev $IFACE metric $METRIC (ipv6_route=$IPV6_ROUTE)"
	else
		log "failed to install IPv6 default route dev $IFACE"
	fi
	policy_add 6
}

del_v6_default() {
	[ "$IPV6_ENABLED" = 1 ] || return 0
	[ "$IPV6_ROUTE" = off ] && return 0
	owner_has v6-default || return 0
	ip -6 route del default dev "$IFACE" metric "$METRIC" 2>/dev/null \
		&& log "removed IPv6 default route dev $IFACE metric $METRIC"
	lock
	owner_del v6-default
	local last
	last="$(owner_count v6-default)"
	unlock
	if [ "$last" -eq 0 ]; then
		policy_del 6
		restore_wan_defaults 6
	fi
}

# --- events ----------------------------------------------------------------

do_connect() {
	local want_v4=0 want_v6=0
	[ "$DEFAULT_ROUTE" = 1 ] && want_v4=1
	if [ "$IPV6_ENABLED" = 1 ] && [ "$IPV6_ROUTE" != off ]; then
		want_v6=1
		if [ "$IPV6_ROUTE" = auto ] && [ -n "$(v6_foreign_default)" ]; then
			want_v6=0
		fi
	fi
	if [ "$want_v4" = 0 ] && [ "$want_v6" = 0 ]; then
		log "no routing changes requested (default_route=$DEFAULT_ROUTE, ipv6_route=$IPV6_ROUTE)"
		return 0
	fi
	add_v4_default
	add_v6_default
}

do_disconnect() {
	del_endpoint_bypass
	del_v4_default
	del_v6_default
}

case "$EVENT" in
	connect)    log "connect event on $IFACE (endpoint=${ENDPOINT:-unknown})"; do_connect ;;
	disconnect) log "disconnect event on $IFACE"; do_disconnect ;;
	'')         log "USQUE_EVENT not set, nothing to do" ;;
	*)          log "unknown event '$EVENT', nothing to do" ;;
esac

exit 0
