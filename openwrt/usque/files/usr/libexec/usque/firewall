#!/bin/sh
# usque firewall zone helper (v2: multiple tunnel interfaces, optional LAN IPv6)
#
# Creates/updates a dedicated fw4 zone for all enabled usque tunnel
# interfaces and removes it again when the package is uninstalled:
#
#   firewall.usque       zone: name usque, device list <ifaces>, input REJECT,
#                              output ACCEPT, forward REJECT, masq, masq6,
#                              mtu_fix
#   firewall.usque_<z>   forwarding <z> -> usque for every internal zone <z>
#                        that forwards to wan (lan, guest, ...); lan is always
#                        included.
#
# Usage: firewall setup <iface> [<iface> ...]   (idempotent)
#        firewall teardown                       (idempotent)
#
# The existing WAN zone is never touched.

ZONE=usque
changed=0

log() { logger -t usque "firewall: $*"; }

fw4_reload() {
	if command -v fw4 >/dev/null 2>&1; then
		fw4 reload >/dev/null 2>&1 || log "fw4 reload failed"
	else
		log "fw4 not found, firewall changes will apply on next reload"
	fi
}

# Names of zones that have a forwarding rule to wan (one per line).
wan_forward_sources() {
	uci -q show firewall 2>/dev/null | while IFS= read -r line; do
		case "$line" in
			*".dest='wan'"*|*".dest=wan"*)
				rest="${line#firewall.}"
				sec="${rest%%.*}"
				[ -n "$sec" ] || continue
				src="$(uci -q get "firewall.$sec.src" 2>/dev/null)" || continue
				case "$src" in
					''|wan|'@'*) continue ;;
				esac
				printf '%s\n' "$src"
				;;
		esac
	done
}

# Union of "lan" and every zone forwarding to wan, deduplicated.
internal_zones() {
	{
		printf 'lan\n'
		wan_forward_sources
	} | while IFS= read -r z; do
		case "$z" in ''|*[!A-Za-z0-9_]*) continue ;; esac
		printf '%s\n' "$z"
	done | sort -u
}

# Current device list of the zone, one per line.
zone_devices() {
	uci -q get "firewall.$ZONE.device" 2>/dev/null | tr ' ' '\n' | grep -v '^$' | sort -u
}

set_zone_devices() {
	local dev
	uci -q delete "firewall.$ZONE.device"
	for dev in "$@"; do
		uci add_list "firewall.$ZONE.device=$dev"
	done
	changed=1
}

setup() {
	local iface src fwd want current

	[ "$#" -gt 0 ] || { log "no tunnel interfaces, nothing to do"; return 0; }
	# De-duplicate the interface list.
	want=""
	for iface in "$@"; do
		case " $want " in
			*" $iface "*) ;;
			*) want="$want $iface" ;;
		esac
	done
	want="${want# }"

	if ! uci -q get "firewall.$ZONE" >/dev/null 2>&1; then
		uci set "firewall.$ZONE=zone"
		uci set "firewall.$ZONE.name=$ZONE"
		uci set "firewall.$ZONE.input=REJECT"
		uci set "firewall.$ZONE.output=ACCEPT"
		uci set "firewall.$ZONE.forward=REJECT"
		uci set "firewall.$ZONE.masq=1"
		uci set "firewall.$ZONE.masq6=1"
		uci set "firewall.$ZONE.mtu_fix=1"
		set_zone_devices $want
		changed=1
	else
		current="$(zone_devices | tr '\n' ' ' | sed 's/ *$//')"
		if [ "$current" != "$want" ]; then
			set_zone_devices $want
		fi
	fi

	# Every internal zone that may forward to the internet must be allowed
	# to forward into the tunnel as well, otherwise LAN/guest clients lose
	# internet access while a tunnel default route is active.
	for src in $(internal_zones); do
		fwd="${ZONE}_${src}"
		if ! uci -q get "firewall.$fwd" >/dev/null 2>&1; then
			uci set "firewall.$fwd=forwarding"
			uci set "firewall.$fwd.src=$src"
			uci set "firewall.$fwd.dest=$ZONE"
			changed=1
			log "added forwarding $src -> $ZONE"
		fi
	done

	if [ "$changed" = 1 ]; then
		uci commit firewall
		log "zone '$ZONE' (devices: $want) configured"
		fw4_reload
	else
		log "zone '$ZONE' (devices: $want) already configured"
	fi
}

teardown() {
	local sec

	for sec in $(uci -q show firewall 2>/dev/null | sed -n "s/^firewall\.\(${ZONE}_[A-Za-z0-9_]*\)=.*/\1/p"); do
		uci delete "firewall.$sec" && changed=1
	done
	if uci -q get "firewall.$ZONE" >/dev/null 2>&1; then
		uci delete "firewall.$ZONE" && changed=1
	fi

	if [ "$changed" = 1 ]; then
		uci commit firewall
		log "zone '$ZONE' and its forwardings removed"
		fw4_reload
	else
		log "zone '$ZONE' not present, nothing to remove"
	fi
}

case "$1" in
	setup)    shift; setup "$@" ;;
	teardown) teardown ;;
	*)        echo "usage: $0 setup <iface> [<iface> ...] | teardown" >&2; exit 1 ;;
esac

exit 0
